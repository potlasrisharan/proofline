{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofline-api",
  "main": "backend/worker.py",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "PROOFLINE_ENV": "production",
    "PROOFLINE_DEV_AUTH": "true",
    "PROOFLINE_ALLOWED_ORIGINS": "https://proofline-4cz.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "PROOFLINE_DB",
      "database_name": "proofline",
      "database_id": "507b5293-0765-4497-9739-510a25639f17",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AUDIT_QUEUE",
        "queue": "proofline-audits"
      }
    ]
  }
}
