{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofline-api",
  "main": "backend/worker.py",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "PROOFLINE_ENV": "production",
    "PROOFLINE_DEV_AUTH": "false",
    "PROOFLINE_ALLOWED_ORIGINS": "https://REPLACE_WITH_PAGES_DOMAIN"
  },
  "d1_databases": [
    {
      "binding": "PROOFLINE_DB",
      "database_name": "proofline",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROOFLINE_FILES",
      "bucket_name": "proofline-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AUDIT_QUEUE",
        "queue": "proofline-audits"
      }
    ]
  }
}
