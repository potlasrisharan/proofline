# Copy to .env.local or .env only on a private machine; never commit the copy.
# All values below are intentionally blank or local-safe placeholders.
# The backend reads exported variables (or Uvicorn --env-file .env); it does not
# automatically load this file. Compose only uses PORT/BACKEND_PORT for host ports
# and deliberately does not forward keys, enable dev auth, or connect providers.

# IMPLEMENTED: backend runtime and local launcher settings.
PROOFLINE_ENV=development
# Local smoke tests only; not a deployed authentication mechanism.
PROOFLINE_DEV_AUTH=false
BACKEND_PORT=8000
PORT=3000

# IMPLEMENTED boundary, STUB integration: local HS256 verification only. A deployed
# Worker is intended to sit behind Cloudflare Access and D1 membership checks; these
# values do not enable production identity by themselves.
PROOFLINE_JWT_SECRET=
PROOFLINE_ACCESS_TEAM_DOMAIN=
PROOFLINE_ACCESS_AUDIENCE=
PROOFLINE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# Browser API pairing. Keep this disabled for the seeded demo. For local development,
# set API_AUTH to development_headers and use fictional VoltEdge identity values below.
# Cloudflare Access cookie mode remains a deployment boundary and is not implemented by
# the local browser adapter; do not put bearer secrets here.
NEXT_PUBLIC_PROOFLINE_LOCAL_API=false
NEXT_PUBLIC_PROOFLINE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PROOFLINE_API_AUTH=development_headers
NEXT_PUBLIC_PROOFLINE_API_USER=user-voltedge-ui
NEXT_PUBLIC_PROOFLINE_API_ORGANISATION=org-voltedge-ui
NEXT_PUBLIC_PROOFLINE_API_ROLE=creator
NEXT_PUBLIC_PROOFLINE_API_AGENCY=

# Cloudflare bindings are configured in wrangler.jsonc, not in browser-exposed env.
# Replace placeholders in a private deployment config or create the resources with
# Wrangler. Never commit account IDs, database IDs, API tokens, or private secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=proofline
CLOUDFLARE_WORKER_NAME=proofline-api
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET=proofline-files
CLOUDFLARE_AUDIT_QUEUE=proofline-audits

# PLANNED: model-assisted checks are not active in the current local runtime.
GEMINI_API_KEY=
GEMINI_MODEL=

# Cloudflare API tokens belong in local shell/CI secret storage, never in this file.
# CLOUDFLARE_API_TOKEN=
