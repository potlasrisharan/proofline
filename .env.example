# Copy to .env.local or .env only on a private machine; never commit the copy.
PROOFLINE_ENV=development

# Disabled by default. Development headers are for local smoke tests only.
PROOFLINE_DEV_AUTH=false

# Optional Supabase configuration. The Phase 1 API does not claim a live Supabase
# adapter; these values only enable the JWT verification boundary when wired safely.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Never put a Supabase service-role key in browser code or committed files.
# SUPABASE_SERVICE_ROLE_KEY=
