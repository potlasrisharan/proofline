# Copy to .env.local or .env only on a private machine; never commit the copy.
# All values below are intentionally blank or local-safe placeholders.
# The backend reads exported variables (or Uvicorn --env-file .env); it does not
# automatically load this file. Compose only uses PORT/BACKEND_PORT for host ports
# and deliberately does not forward keys, enable dev auth, or connect providers.

# IMPLEMENTED: backend runtime and local launcher settings.
PROOFLINE_ENV=development
# Local smoke tests only; not a deployed authentication mechanism.
PROOFLINE_DEV_AUTH=false
BACKEND_PORT=8000
PORT=3000

# IMPLEMENTED boundary, STUB integration: the Phase 1 API does not claim a live
# Supabase adapter. A JWT secret only enables local token verification.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# PLANNED: model-assisted checks are not active in the current local runtime.
GEMINI_API_KEY=
GEMINI_MODEL=

# Never put a Supabase service-role key in browser code or committed files.
# SUPABASE_SERVICE_ROLE_KEY=
